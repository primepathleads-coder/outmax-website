# Outmax Services Team Portal Environment Variables
# Add these into your Vercel Dashboard (Project Settings > Environment Variables) or locally in .env

# Option 1: Resend (Recommended & Fastest setup - https://resend.com)
# Create a free API key at resend.com and paste below:
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL="Outmax Services <auth@outmaxservices.com>"

# Option 2: SMTP (Gmail, Zoho, Hostinger, AWS SES, Brevo)
# If using Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Outmax Services <your_email@gmail.com>"
